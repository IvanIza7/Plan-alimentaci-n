rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /inventory/{itemId} {
      allow read, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().ownerId == request.auth.uid;
    }

    match /shoppingHistory/{historyId} {
      allow read, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().ownerId == request.auth.uid;
    }
    match /shoppingList/{itemId} {
      allow read, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().ownerId == request.auth.uid;
    }

    match /menus/{menuId} {
      allow read, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().ownerId == request.auth.uid;
    }

    match /activeMenus/{activeMenuId} {
      allow read, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().ownerId == request.auth.uid;
    }

    match /weightHistory/{historyId} {
      allow read, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().ownerId == request.auth.uid;
    }
    
    match /consumptionLogs/{logId} {
      allow read, delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create, update: if isSignedIn() && incoming().ownerId == request.auth.uid;
    }
  }
}
